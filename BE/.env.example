# ---------------- Application ----------------
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------- Security ----------------
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_SIGNUP_ROLE=analyst
ADMIN_EMAIL=admin@deallens.local
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Platform Administrator

# ---------------- PostgreSQL + pgvector ----------------
POSTGRES_DB=mna_diligence
POSTGRES_USER=mna_app
POSTGRES_PASSWORD=your-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------- Storage ----------------
STORAGE_DIR=storage/uploads
MAX_UPLOAD_MB=50

# ---------------- Document processing / OCR ----------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
OCR_ENABLED=true
# rapidocr (local, open source) | gemini (vision model)
OCR_ENGINE=rapidocr
OCR_MIN_CHARS_PER_PAGE=40
AUTO_SUMMARIZE_DOCUMENTS=true

# ---------------- Open-source models (local) ----------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# ---------------- Retrieval ----------------
RETRIEVAL_FINAL_K=6
RETRIEVAL_RERANK_CANDIDATES=24

# ---------------- Gemini LLM ----------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_MODEL=
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
